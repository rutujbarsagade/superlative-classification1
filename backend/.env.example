# Django
SECRET_KEY=django-insecure-local-development-only-do-not-use-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
ANON_THROTTLE_RATE=30/min
USER_THROTTLE_RATE=60/min

# PostgreSQL
POSTGRES_DB=superlative_classification
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_TEST_DB=test_superlative_classification

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1

# Email
# Development emails (including verification links) are printed in the backend console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=admin@example.com
SUPER_ADMIN_EMAILS=admin@example.com
EMAIL_VERIFICATION_TOKEN_MAX_AGE=86400
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
FRONTEND_BASE_URL=http://localhost:5173

MAX_DATASET_UPLOAD_BYTES=10485760
MAX_DATASET_REQUEST_BYTES=12582912
MAX_DATASET_ROWS=100000
MAX_DATASET_COLUMNS=200
MAX_PREVIEW_ROWS=10
MAX_USER_MODEL_COUNT=100
MAX_USER_STORAGE_BYTES=524288000
DATA_UPLOAD_MAX_MEMORY_SIZE=12582912

# Filesystem storage. Relative paths are resolved from the backend directory.
STORAGE_ROOT=../storage
